;;; wltest - debug: show BLEND value as red channel
(setq wltest-shader
(make-shader wltest :keyword :light
  (((from        point) (make-point 0 18 0))
   ((to          point) (make-point 0 0 0))
   ((center      point) (make-point -2.0 0 2.0))
   ((up          point) (make-point 1 0 0))
   ((hpanes      float) 3.0)
   ((vpanes      float) 3.0)
   ((panewidth   float) 3.5)
   ((paneheight  float) 3.5)
   ((framewidth  float) 0.25)
   ((frameheight float) 0.25)
   ((fuzz        float) 0.15))
  (enter (
    ((path  point) (make-point 0 0 0))
    ((right point) (make-point 0 0 0))
    ((upv   point) (make-point 0 0 0))
    ((LP    point) (make-point 0 0 0))
    ((px    float) 0.0)
    ((py    float) 0.0)
    ((ox    float) 0.0)
    ((oy    float) 0.0)
    ((xmod  float) 0.0)
    ((ymod  float) 0.0)
    ((xflo  float) 0.0)
    ((yflo  float) 0.0)
    ((blend float) 0.0)
    ((fxlo  float) 0.0)
    ((fxhi  float) 0.0)
    ((fylo  float) 0.0)
    ((fyhi  float) 0.0))

    (setvar path  (normalize (- to from)))
    (setvar right (normalize (cross up path)))
    (setvar upv   (normalize (cross path right)))
    (setvar fxlo (+ (* framewidth  0.5) fuzz))
    (setvar fxhi (- panewidth  (* framewidth  0.5)))
    (setvar fylo (+ (* frameheight 0.5) fuzz))
    (setvar fyhi (- paneheight (* frameheight 0.5)))

    (solar (path 1.5)
      (setvar LP (- P center))
      (setvar px (dot LP right))
      (setvar py (dot LP upv))
      (setvar ox (+ px (* panewidth  (/ hpanes  2.0))))
      (setvar oy (+ py (* paneheight (/ vpanes  2.0))))
      (setvar xmod (mod ox panewidth))
      (setvar ymod (mod oy paneheight))

      (setvar xflo (- (smoothstep (* framewidth  0.5) fxlo xmod)
                      (smoothstep (- fxhi fuzz) fxhi xmod)))
      (setvar yflo (- (smoothstep (* frameheight 0.5) fylo ymod)
                      (smoothstep (- fyhi fuzz) fyhi ymod)))

      (if (< xflo 0.0) (setvar xflo 0.0) (setvar xflo xflo))
      (if (< yflo 0.0) (setvar yflo 0.0) (setvar yflo yflo))

      (setvar blend (* xflo yflo))
      ;; red=blend, green=xflo, blue=yflo
      (setvar Cl (make-color blend xflo yflo))))))
(compile-shader wltest-shader)
(append-shader wltest-shader)
