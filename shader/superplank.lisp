;;; superplank.lisp — compact procedural plank/varnish port of superplank.sl.
(setq superplank-shader
(make-shader superplank :keyword :surface
  (((Ka float) 0.7) ((Kd float) 0.75) ((Ks float) 0.35) ((roughness float) 0.12)
   ((specularcolor color) (make-color 1 1 1)) ((Kr float) 0.12)
   ((txtscale float) 1.0) ((Km float) 0.08)
   ((lightwood color) (make-color 0.52 0.24 0.07)) ((plankpattern float) 0.0)
   ((plankspertile float) 4.0) ((plankwidth float) 0.25) ((planklength float) 1.6)
   ((groovewidth float) 0.018) ((groovedepth float) 0.08)
   ((groovecolor color) (make-color 0.035 0.018 0.008))
   ((plankstagger float) 0.5) ((plankvary float) 0.22)
   ((ringscale float) 9.0) ((ringwidth float) 0.18)
   ((wavy float) 0.18) ((grainy float) 0.35) ((grainscale float) 28.0)
   ((graindepth float) 0.04) ((mapping float) 1.0))
  (enter (((Nf point) (faceforward (normalize N) I)) ((Nw point) Nf)
          ((Vdir point) (normalize (- I))) ((ss float) 0) ((tt float) 0)
          ((anx float) (abs (xcomp Nf))) ((any float) (abs (ycomp Nf)))
          ((anz float) (abs (zcomp Nf))) ((pp point) Pobject)
          ((row float) 0) ((col float) 0) ((fu float) 0) ((fv float) 0)
          ((edgeu float) 0) ((edgev float) 0) ((groove float) 0)
          ((cell float) 0) ((ring float) 0) ((grain float) 0)
          ((wood color) lightwood) ((R point) (make-point 0 0 0))
          ((hitc color) (make-color 0 0 0)) ((fres float) 0)
          ((cellw float) 0) ((cswp float) 0) ((tmp2 float) 0))
    (if (> mapping 1.5) (setvar pp Pg))
    ;; SDF primitives do not carry stable mesh UVs.  Use dominant-axis
    ;; triplanar coordinates so flat box faces do not all collapse to s=t=0
    ;; and get mistaken for a groove.
    (if (< mapping 0.5)
        (progn (setvar ss (* s txtscale)) (setvar tt (* t txtscale)))
      (if (> any (max anx anz))
        (progn (setvar ss (* (xcomp pp) txtscale))
               (setvar tt (* (zcomp pp) txtscale)))
        (if (> anx anz)
            (progn (setvar ss (* (zcomp pp) txtscale))
                   (setvar tt (* (ycomp pp) txtscale)))
            (progn (setvar ss (* (xcomp pp) txtscale))
                   (setvar tt (* (ycomp pp) txtscale))))))
    ;; ── parquet (plankpattern 2, 2026-08-09 復活): plankspertile 四方の市松で uv 交換 ──
    (if (> plankpattern 1.5)
        (progn
          (setvar cellw (* plankwidth plankspertile))
          (setvar cswp (+ (floor (/ ss cellw)) (floor (/ tt cellw))))
          (setvar cswp (- cswp (* 2.0 (floor (/ cswp 2.0)))))
          (if (> cswp 0.5)
              (progn (setvar tmp2 ss) (setvar ss tt) (setvar tt tmp2)))))
    (setvar row (floor (/ tt plankwidth)))
    (setvar ss (+ ss (* plankstagger row)))
    (setvar col (floor (/ ss planklength)))
    (setvar fu (- (/ ss planklength) (floor (/ ss planklength))))
    (setvar fv (- (/ tt plankwidth) (floor (/ tt plankwidth))))
    (if (and (> plankpattern 0.5) (< plankpattern 1.5))
      (progn (setvar fu (- (/ tt planklength) (floor (/ tt planklength))))
             (setvar fv (- (/ ss plankwidth) (floor (/ ss plankwidth))))))
    (setvar edgeu (min fu (- 1 fu)))
    (setvar edgev (min fv (- 1 fv)))
    (setvar groove (- 1 (* (smoothstep 0 groovewidth edgeu) (smoothstep 0 groovewidth edgev))))
    (setvar cell (- (* 2 (noise (make-point row col 13.7))) 1))
    (setvar ring (pow (clamp (- 1 (abs (sin (+ (* ringscale fu) (* wavy (noise (* Pg 2))))))) 0 1)
                       (/ 1.0 (max ringwidth 0.02))))
    (setvar grain (* grainy (pow (clamp (noise (* Pg grainscale (make-point 1 0.08 1))) 0 1) 5)))
    (setvar wood (* lightwood (+ 1 (* plankvary cell))))
    (setvar wood (* wood (- 1 (* 0.5 (max ring grain)))))
    (setvar wood (mix wood groovecolor groove))
    (setvar Nw (normalize (- Nf (* (+ (* Km groovedepth groove) (* graindepth grain))
                                      (make-point (- fu 0.5) 0 (- fv 0.5))))))
    (setvar R (reflect I Nw))
    (setvar hitc (trace P R))
    (setvar fres (+ 0.04 (* 0.96 (pow (- 1 (clamp (dot Nw Vdir) 0 1)) 5))))
    (setvar Oi Os)
    (setvar Ci (* Oi (+ (* wood (+ (* Ka (ambient)) (* Kd (diffuse Nw))))
                         (* specularcolor Ks (specular Nw Vdir roughness))
                         (* hitc Kr fres)))))))
(compile-shader superplank-shader)
(append-shader superplank-shader)
