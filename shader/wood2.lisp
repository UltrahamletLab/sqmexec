;;; wood2.lisp — BMRT wood2.sl solid procedural wood port.
(setq wood2-shader
(make-shader wood2 :keyword :surface
  (((Ka float) 1.0) ((Kd float) 0.75) ((Ks float) 0.4)
   ((roughness float) 0.1) ((ringscale float) 15.0) ((txtscale float) 1.0)
   ((lightwood color) (make-color 0.69 0.44 0.25))
   ((darkwood color) (make-color 0.35 0.22 0.08)) ((grainy float) 1.0)
   ((mapping float) 1.0))
  (enter (((Nf point) (faceforward (normalize N) I))
          ((Vdir point) (normalize (- I))) ((pp point) Pobject)
          ((pq point) (make-point 0 0 0)) ((myt float) 0)
          ((rr float) 0) ((r2 float) 0) ((mixv float) 0)
          ((Ct color) lightwood))
    (if (< mapping 0.5) (setvar pp (make-point s t 0)))
    (if (> mapping 1.5) (setvar pp Pg))
    (setvar pp (* pp txtscale))
    (setvar myt (/ (zcomp pp) (max ringscale 0.0001)))
    (setvar pq (make-point (* (xcomp pp) 8) (* (ycomp pp) 8) (zcomp pp)))
    (setvar myt (+ myt (/ (noise pq) 16)))
    (setvar pq (make-point (xcomp pp) myt (+ (ycomp pp) 12.93)))
    (setvar rr (* ringscale (noise pq)))
    (setvar rr (- rr (floor rr)))
    (setvar rr (+ 0.2 (* 0.8 (smoothstep 0.2 0.55 rr)
                              (- 1 (smoothstep 0.75 0.8 rr)))))
    (setvar pq (make-point (+ (* (xcomp pp) 128) 5)
                           (- (* (zcomp pp) 8) 3)
                           (+ (* (ycomp pp) 128) 1)))
    (setvar r2 (+ (* grainy (- 1.3 (noise pq))) (- 1 grainy)))
    (setvar mixv (clamp (* rr r2 r2) 0 1))
    (setvar Ct (mix lightwood darkwood mixv))
    (setvar Oi Os)
    (setvar Ci (* Oi (+ (* Ct (+ (* Ka (ambient)) (* Kd (diffuse Nf))))
                         (* Ks (specular Nf Vdir roughness))))))))
(compile-shader wood2-shader)
(append-shader wood2-shader)
