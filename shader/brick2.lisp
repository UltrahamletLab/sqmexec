;;; brick2
(setq brick2-shader
(make-shader brick2 :keyword :surface
      (
        ((Kd float) 1)
        ((Ka float) 1)
        ((Cbrick color) (make-color 0.5 0.15 0.14))
        ((Cmortar color) (make-color 0.5 0.5 0.5))
        ((BRICKWIDTH float) 0.25)
        ((BRICKHEIGHT float) 0.08)
        ((MORTARTHICKNESS float) 0.01)
       )
  (enter (
          ((Ct color) (make-color 1 0 0))
          ((NN point) (faceforward (normalize N) I))
          ((BMWIDTH float) (+ BRICKWIDTH MORTARTHICKNESS))
          ((BMHEIGHT float) (+ BRICKHEIGHT MORTARTHICKNESS))
          ((ss float) 1) ((tt float) 1)
          ((sbrick float) 1) ((tbrick float) 1)
          ((w float) 1) ((h float) 1)
          ((scoord float) s) ((tcoord float) t)
          ((MWF float) (/ (* MORTARTHICKNESS 0.5) BMWIDTH))
          ((MHF float) (/ (* MORTARTHICKNESS 0.5) BMHEIGHT))
          )
        (setvar ss (/ scoord BMWIDTH))
        (setvar tt (/ tcoord BMHEIGHT))
        (if (> (mod (* tt 0.5) 1) 0.5)
            (setvar ss (+ ss 0.5)))
        (setvar tbrick (floor tt))
        (setvar sbrick (floor ss))
        (setvar ss (- ss sbrick))
        (setvar tt (- tt tbrick))
        (setvar w (- (step MWF ss) (step (- 1 MWF) ss)))
        (setvar h (- (step MHF tt) (step (- 1 MHF) tt)))
        (setvar Ct (mix Cmortar Cbrick (* w h)))
        (setvar Oi Os)
        (setvar Ci (* Oi Ct (+ (* Ka (ambient)) (* Kd (diffuse NN)))))
)))
(compile-shader brick2-shader)
(append-shader brick2-shader)
