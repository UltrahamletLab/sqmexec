;;; seascape.lisp — TDM "Seascape" (Alexander Alekseev, 2014) as an sqm surface shader.
;;;
;;; 平面に貼って外洋を表現する。元の Shadertoy はハイトフィールドをレイマーチして
;;; ジオメトリ自体を波にするが、sqm ではサーフェスシェーダーなので「波の高さ場 h(x,z) を
;;; getwaves で評価 → 有限差分で法線を作り、平面の法線を揺らす(=bump)」方式に移植。
;;; 色は Seascape オリジナルのモデル: フレネルで空反射と海中色をブレンド + 高さ着色 + 鋭い太陽スペキュラ。
;;;
;;;   sea_octave(uv,c): uv += noise(uv); wv=1-|sin(uv)|; swv=|cos(uv)|;
;;;                     wv=mix(wv,swv,wv); return pow(1-pow(wv.x*wv.y,0.65),c)
;;;   getwaves: ITER 回 (uv±time)*freq で sea_octave 2回足し、octave 行列で回転しつつ
;;;             freq*=1.9 amp*=0.22 choppy→1 へ。DSL にループが無いので 3 オクターブを展開。
;;;   法線: 中心/+dx/+dz の3点で h を評価する有限差分 (Seascape getNormal と同型)。
;;;
;;; ※ このファイルは dr_sbcl/shader/seascape.gen.py で生成 (3点×3オクターブの反復を機械生成)。
;;;
;;; パラメータ定義順 (shade_dr.c の seascape_params[] と一致必須):
;;;   Ka=0 Ks=1 roughness=2 Kr=3 base-color=4 water-color=5 wave-freq=6 wave-height=7
;;;   choppy=8 fresnel-power=9 fresnel-max=10 phase=11 fd-eps=12 sun-glint=13 fade-far=14

(setq seascape-shader
(make-shader seascape :keyword :surface
  (((Ka float) 0.0) ((Ks float) 0.6) ((roughness float) 0.006) ((Kr float) 0.9)
   ((base-color  color) (make-color 0.0 0.09 0.18))   ; SEA_BASE
   ((water-color color) (make-color 0.48 0.54 0.36))  ; SEA_WATER_COLOR (=vec3(.8,.9,.6)*.6)
   ((wave-freq   float) 0.16)   ; SEA_FREQ
   ((wave-height float) 0.6)    ; SEA_HEIGHT
   ((choppy      float) 4.0)    ; SEA_CHOPPY
   ((fresnel-power float) 3.0)
   ((fresnel-max   float) 0.5)
   ((phase       float) 0.0)    ; 波ドリフト位相 (= SEA_TIME, アニメ用)
   ((fd-eps      float) 0.08)   ; 法線の有限差分ステップ
   ((sun-glint   float) 1.0)
   ((fade-far    float) 60.0))  ; 距離フェード(LOD): 遠景の波を平滑化しシマー抑制
  (enter (
    ((px float) 0) ((pz float) 0)
    ((qx float) 0) ((qz float) 0) ((nqx float) 0) ((nqz float) 0)
    ((ox float) 0) ((oz float) 0) ((wp float) 0)
    ((wx float) 0) ((wz float) 0) ((cx float) 0) ((cz float) 0)
    ((dd float) 0) ((hacc float) 0)
    ((hc float) 0) ((hdx float) 0) ((hdz float) 0)
    ((nx float) 0) ((nz float) 0)
    ((freq0 float) 0) ((freq1 float) 0) ((freq2 float) 0)
    ((amp0 float) 0) ((amp1 float) 0) ((amp2 float) 0)
    ((chop0 float) 0) ((chop1 float) 0) ((chop2 float) 0)
    ((dist float) 0) ((atten float) 0) ((fade float) 0) ((invf float) 1) ((nearf float) 0)
    ((facing float) 0) ((fres float) 0) ((hit float) 0)
    ((Ir point) (make-point 0 0 1)) ((Nw point) (make-point 0 1 0)) ((rdir point) (make-point 0 1 0))
    ((refl color) (make-color 0 0 0)) ((refr color) (make-color 0 0 0)) ((col color) (make-color 0 0 0)))

  ;; --- octave schedule (freq*1.9, amp*0.22, choppy -> 1) ---
  (setvar freq0 wave-freq) (setvar amp0 wave-height) (setvar chop0 choppy)
  (setvar freq1 (* freq0 1.9)) (setvar amp1 (* amp0 0.22)) (setvar chop1 (+ chop0 (* (- 1 chop0) 0.2)))
  (setvar freq2 (* freq1 1.9)) (setvar amp2 (* amp1 0.22)) (setvar chop2 (+ chop1 (* (- 1 chop1) 0.2)))
  (setvar px (xcomp Pg)) (setvar pz (zcomp Pg))

  ;; --- distance fade (LOD): smooth distant water to kill shimmer ---
  (setvar dist (length (- E Pg)))
  (setvar nearf (* fade-far 0.3))
  (setvar fade (smoothstep nearf fade-far dist))
  (setvar invf (- 1 fade))

  ;; --- getwaves heights at center / +dx / +dz (finite-difference normal) ---
    (setvar qx (* px 0.75)) (setvar qz pz)
    (setvar hacc 0)
    ; -- octave 0 --
    (setvar ox (* (+ qx phase) freq0))
    (setvar oz (* (+ qz phase) freq0))
    (setvar wp (noise (make-point ox oz 0.0)))
    (setvar ox (+ ox wp)) (setvar oz (+ oz wp))
    (setvar wx (- 1 (abs (sin ox))))
    (setvar wz (- 1 (abs (sin oz))))
    (setvar cx (abs (cos ox)))
    (setvar cz (abs (cos oz)))
    (setvar wx (+ wx (* (- cx wx) wx)))
    (setvar wz (+ wz (* (- cz wz) wz)))
    (setvar dd (pow (- 1 (pow (* wx wz) 0.65)) chop0))
    (setvar ox (* (- qx phase) freq0))
    (setvar oz (* (- qz phase) freq0))
    (setvar wp (noise (make-point ox oz 0.0)))
    (setvar ox (+ ox wp)) (setvar oz (+ oz wp))
    (setvar wx (- 1 (abs (sin ox))))
    (setvar wz (- 1 (abs (sin oz))))
    (setvar cx (abs (cos ox)))
    (setvar cz (abs (cos oz)))
    (setvar wx (+ wx (* (- cx wx) wx)))
    (setvar wz (+ wz (* (- cz wz) wz)))
    (setvar dd (+ dd (pow (- 1 (pow (* wx wz) 0.65)) chop0)))
    (setvar hacc (+ hacc (* dd amp0)))
    (setvar nqx (+ (* 1.6 qx) (* 1.2 qz)))
    (setvar nqz (+ (* -1.2 qx) (* 1.6 qz)))
    (setvar qx nqx) (setvar qz nqz)
    ; -- octave 1 --
    (setvar ox (* (+ qx phase) freq1))
    (setvar oz (* (+ qz phase) freq1))
    (setvar wp (noise (make-point ox oz 0.0)))
    (setvar ox (+ ox wp)) (setvar oz (+ oz wp))
    (setvar wx (- 1 (abs (sin ox))))
    (setvar wz (- 1 (abs (sin oz))))
    (setvar cx (abs (cos ox)))
    (setvar cz (abs (cos oz)))
    (setvar wx (+ wx (* (- cx wx) wx)))
    (setvar wz (+ wz (* (- cz wz) wz)))
    (setvar dd (pow (- 1 (pow (* wx wz) 0.65)) chop1))
    (setvar ox (* (- qx phase) freq1))
    (setvar oz (* (- qz phase) freq1))
    (setvar wp (noise (make-point ox oz 0.0)))
    (setvar ox (+ ox wp)) (setvar oz (+ oz wp))
    (setvar wx (- 1 (abs (sin ox))))
    (setvar wz (- 1 (abs (sin oz))))
    (setvar cx (abs (cos ox)))
    (setvar cz (abs (cos oz)))
    (setvar wx (+ wx (* (- cx wx) wx)))
    (setvar wz (+ wz (* (- cz wz) wz)))
    (setvar dd (+ dd (pow (- 1 (pow (* wx wz) 0.65)) chop1)))
    (setvar hacc (+ hacc (* dd amp1)))
    (setvar nqx (+ (* 1.6 qx) (* 1.2 qz)))
    (setvar nqz (+ (* -1.2 qx) (* 1.6 qz)))
    (setvar qx nqx) (setvar qz nqz)
    ; -- octave 2 --
    (setvar ox (* (+ qx phase) freq2))
    (setvar oz (* (+ qz phase) freq2))
    (setvar wp (noise (make-point ox oz 0.0)))
    (setvar ox (+ ox wp)) (setvar oz (+ oz wp))
    (setvar wx (- 1 (abs (sin ox))))
    (setvar wz (- 1 (abs (sin oz))))
    (setvar cx (abs (cos ox)))
    (setvar cz (abs (cos oz)))
    (setvar wx (+ wx (* (- cx wx) wx)))
    (setvar wz (+ wz (* (- cz wz) wz)))
    (setvar dd (pow (- 1 (pow (* wx wz) 0.65)) chop2))
    (setvar ox (* (- qx phase) freq2))
    (setvar oz (* (- qz phase) freq2))
    (setvar wp (noise (make-point ox oz 0.0)))
    (setvar ox (+ ox wp)) (setvar oz (+ oz wp))
    (setvar wx (- 1 (abs (sin ox))))
    (setvar wz (- 1 (abs (sin oz))))
    (setvar cx (abs (cos ox)))
    (setvar cz (abs (cos oz)))
    (setvar wx (+ wx (* (- cx wx) wx)))
    (setvar wz (+ wz (* (- cz wz) wz)))
    (setvar dd (+ dd (pow (- 1 (pow (* wx wz) 0.65)) chop2)))
    (setvar hacc (+ hacc (* dd amp2)))
    (setvar nqx (+ (* 1.6 qx) (* 1.2 qz)))
    (setvar nqz (+ (* -1.2 qx) (* 1.6 qz)))
    (setvar qx nqx) (setvar qz nqz)
    (setvar hc hacc)
    (setvar qx (* (+ px fd-eps) 0.75)) (setvar qz pz)
    (setvar hacc 0)
    ; -- octave 0 --
    (setvar ox (* (+ qx phase) freq0))
    (setvar oz (* (+ qz phase) freq0))
    (setvar wp (noise (make-point ox oz 0.0)))
    (setvar ox (+ ox wp)) (setvar oz (+ oz wp))
    (setvar wx (- 1 (abs (sin ox))))
    (setvar wz (- 1 (abs (sin oz))))
    (setvar cx (abs (cos ox)))
    (setvar cz (abs (cos oz)))
    (setvar wx (+ wx (* (- cx wx) wx)))
    (setvar wz (+ wz (* (- cz wz) wz)))
    (setvar dd (pow (- 1 (pow (* wx wz) 0.65)) chop0))
    (setvar ox (* (- qx phase) freq0))
    (setvar oz (* (- qz phase) freq0))
    (setvar wp (noise (make-point ox oz 0.0)))
    (setvar ox (+ ox wp)) (setvar oz (+ oz wp))
    (setvar wx (- 1 (abs (sin ox))))
    (setvar wz (- 1 (abs (sin oz))))
    (setvar cx (abs (cos ox)))
    (setvar cz (abs (cos oz)))
    (setvar wx (+ wx (* (- cx wx) wx)))
    (setvar wz (+ wz (* (- cz wz) wz)))
    (setvar dd (+ dd (pow (- 1 (pow (* wx wz) 0.65)) chop0)))
    (setvar hacc (+ hacc (* dd amp0)))
    (setvar nqx (+ (* 1.6 qx) (* 1.2 qz)))
    (setvar nqz (+ (* -1.2 qx) (* 1.6 qz)))
    (setvar qx nqx) (setvar qz nqz)
    ; -- octave 1 --
    (setvar ox (* (+ qx phase) freq1))
    (setvar oz (* (+ qz phase) freq1))
    (setvar wp (noise (make-point ox oz 0.0)))
    (setvar ox (+ ox wp)) (setvar oz (+ oz wp))
    (setvar wx (- 1 (abs (sin ox))))
    (setvar wz (- 1 (abs (sin oz))))
    (setvar cx (abs (cos ox)))
    (setvar cz (abs (cos oz)))
    (setvar wx (+ wx (* (- cx wx) wx)))
    (setvar wz (+ wz (* (- cz wz) wz)))
    (setvar dd (pow (- 1 (pow (* wx wz) 0.65)) chop1))
    (setvar ox (* (- qx phase) freq1))
    (setvar oz (* (- qz phase) freq1))
    (setvar wp (noise (make-point ox oz 0.0)))
    (setvar ox (+ ox wp)) (setvar oz (+ oz wp))
    (setvar wx (- 1 (abs (sin ox))))
    (setvar wz (- 1 (abs (sin oz))))
    (setvar cx (abs (cos ox)))
    (setvar cz (abs (cos oz)))
    (setvar wx (+ wx (* (- cx wx) wx)))
    (setvar wz (+ wz (* (- cz wz) wz)))
    (setvar dd (+ dd (pow (- 1 (pow (* wx wz) 0.65)) chop1)))
    (setvar hacc (+ hacc (* dd amp1)))
    (setvar nqx (+ (* 1.6 qx) (* 1.2 qz)))
    (setvar nqz (+ (* -1.2 qx) (* 1.6 qz)))
    (setvar qx nqx) (setvar qz nqz)
    ; -- octave 2 --
    (setvar ox (* (+ qx phase) freq2))
    (setvar oz (* (+ qz phase) freq2))
    (setvar wp (noise (make-point ox oz 0.0)))
    (setvar ox (+ ox wp)) (setvar oz (+ oz wp))
    (setvar wx (- 1 (abs (sin ox))))
    (setvar wz (- 1 (abs (sin oz))))
    (setvar cx (abs (cos ox)))
    (setvar cz (abs (cos oz)))
    (setvar wx (+ wx (* (- cx wx) wx)))
    (setvar wz (+ wz (* (- cz wz) wz)))
    (setvar dd (pow (- 1 (pow (* wx wz) 0.65)) chop2))
    (setvar ox (* (- qx phase) freq2))
    (setvar oz (* (- qz phase) freq2))
    (setvar wp (noise (make-point ox oz 0.0)))
    (setvar ox (+ ox wp)) (setvar oz (+ oz wp))
    (setvar wx (- 1 (abs (sin ox))))
    (setvar wz (- 1 (abs (sin oz))))
    (setvar cx (abs (cos ox)))
    (setvar cz (abs (cos oz)))
    (setvar wx (+ wx (* (- cx wx) wx)))
    (setvar wz (+ wz (* (- cz wz) wz)))
    (setvar dd (+ dd (pow (- 1 (pow (* wx wz) 0.65)) chop2)))
    (setvar hacc (+ hacc (* dd amp2)))
    (setvar nqx (+ (* 1.6 qx) (* 1.2 qz)))
    (setvar nqz (+ (* -1.2 qx) (* 1.6 qz)))
    (setvar qx nqx) (setvar qz nqz)
    (setvar hdx hacc)
    (setvar qx (* px 0.75)) (setvar qz (+ pz fd-eps))
    (setvar hacc 0)
    ; -- octave 0 --
    (setvar ox (* (+ qx phase) freq0))
    (setvar oz (* (+ qz phase) freq0))
    (setvar wp (noise (make-point ox oz 0.0)))
    (setvar ox (+ ox wp)) (setvar oz (+ oz wp))
    (setvar wx (- 1 (abs (sin ox))))
    (setvar wz (- 1 (abs (sin oz))))
    (setvar cx (abs (cos ox)))
    (setvar cz (abs (cos oz)))
    (setvar wx (+ wx (* (- cx wx) wx)))
    (setvar wz (+ wz (* (- cz wz) wz)))
    (setvar dd (pow (- 1 (pow (* wx wz) 0.65)) chop0))
    (setvar ox (* (- qx phase) freq0))
    (setvar oz (* (- qz phase) freq0))
    (setvar wp (noise (make-point ox oz 0.0)))
    (setvar ox (+ ox wp)) (setvar oz (+ oz wp))
    (setvar wx (- 1 (abs (sin ox))))
    (setvar wz (- 1 (abs (sin oz))))
    (setvar cx (abs (cos ox)))
    (setvar cz (abs (cos oz)))
    (setvar wx (+ wx (* (- cx wx) wx)))
    (setvar wz (+ wz (* (- cz wz) wz)))
    (setvar dd (+ dd (pow (- 1 (pow (* wx wz) 0.65)) chop0)))
    (setvar hacc (+ hacc (* dd amp0)))
    (setvar nqx (+ (* 1.6 qx) (* 1.2 qz)))
    (setvar nqz (+ (* -1.2 qx) (* 1.6 qz)))
    (setvar qx nqx) (setvar qz nqz)
    ; -- octave 1 --
    (setvar ox (* (+ qx phase) freq1))
    (setvar oz (* (+ qz phase) freq1))
    (setvar wp (noise (make-point ox oz 0.0)))
    (setvar ox (+ ox wp)) (setvar oz (+ oz wp))
    (setvar wx (- 1 (abs (sin ox))))
    (setvar wz (- 1 (abs (sin oz))))
    (setvar cx (abs (cos ox)))
    (setvar cz (abs (cos oz)))
    (setvar wx (+ wx (* (- cx wx) wx)))
    (setvar wz (+ wz (* (- cz wz) wz)))
    (setvar dd (pow (- 1 (pow (* wx wz) 0.65)) chop1))
    (setvar ox (* (- qx phase) freq1))
    (setvar oz (* (- qz phase) freq1))
    (setvar wp (noise (make-point ox oz 0.0)))
    (setvar ox (+ ox wp)) (setvar oz (+ oz wp))
    (setvar wx (- 1 (abs (sin ox))))
    (setvar wz (- 1 (abs (sin oz))))
    (setvar cx (abs (cos ox)))
    (setvar cz (abs (cos oz)))
    (setvar wx (+ wx (* (- cx wx) wx)))
    (setvar wz (+ wz (* (- cz wz) wz)))
    (setvar dd (+ dd (pow (- 1 (pow (* wx wz) 0.65)) chop1)))
    (setvar hacc (+ hacc (* dd amp1)))
    (setvar nqx (+ (* 1.6 qx) (* 1.2 qz)))
    (setvar nqz (+ (* -1.2 qx) (* 1.6 qz)))
    (setvar qx nqx) (setvar qz nqz)
    ; -- octave 2 --
    (setvar ox (* (+ qx phase) freq2))
    (setvar oz (* (+ qz phase) freq2))
    (setvar wp (noise (make-point ox oz 0.0)))
    (setvar ox (+ ox wp)) (setvar oz (+ oz wp))
    (setvar wx (- 1 (abs (sin ox))))
    (setvar wz (- 1 (abs (sin oz))))
    (setvar cx (abs (cos ox)))
    (setvar cz (abs (cos oz)))
    (setvar wx (+ wx (* (- cx wx) wx)))
    (setvar wz (+ wz (* (- cz wz) wz)))
    (setvar dd (pow (- 1 (pow (* wx wz) 0.65)) chop2))
    (setvar ox (* (- qx phase) freq2))
    (setvar oz (* (- qz phase) freq2))
    (setvar wp (noise (make-point ox oz 0.0)))
    (setvar ox (+ ox wp)) (setvar oz (+ oz wp))
    (setvar wx (- 1 (abs (sin ox))))
    (setvar wz (- 1 (abs (sin oz))))
    (setvar cx (abs (cos ox)))
    (setvar cz (abs (cos oz)))
    (setvar wx (+ wx (* (- cx wx) wx)))
    (setvar wz (+ wz (* (- cz wz) wz)))
    (setvar dd (+ dd (pow (- 1 (pow (* wx wz) 0.65)) chop2)))
    (setvar hacc (+ hacc (* dd amp2)))
    (setvar nqx (+ (* 1.6 qx) (* 1.2 qz)))
    (setvar nqz (+ (* -1.2 qx) (* 1.6 qz)))
    (setvar qx nqx) (setvar qz nqz)
    (setvar hdz hacc)

  ;; --- normal from height gradient (flattened at distance via invf) ---
  (setvar nx (* (- hc hdx) invf))
  (setvar nz (* (- hc hdz) invf))
  (setvar Nw (normalize (make-point nx fd-eps nz)))
  (setvar Nw (faceforward Nw I))
  (setvar Ir (normalize (- I)))

  ;; --- fresnel: head-on -> water body, grazing -> sky (capped at fresnel-max) ---
  (setvar facing (clamp (dot Nw Ir) 0 1))
  (setvar fres (clamp (pow (- 1 facing) fresnel-power) 0 fresnel-max))

  ;; --- sky reflection (one-bounce trace) and refracted sea body ---
  (setvar rdir (reflect I Nw))
  (setvar refl (* Kr (trace P rdir hit)))
  (setvar refr (+ base-color (* 0.12 (* water-color (diffuse Nw)))))
  (setvar col (mix refr refl fres))

  ;; --- height-based water tint (crests brighter) with distance attenuation ---
  (setvar atten (clamp (- 1 (* dist 0.001)) 0 1))
  (setvar col (+ col (* water-color (* (* (- hc wave-height) 0.18) atten))))

  ;; --- sharp sun glint (faded with distance) + tiny ambient ---
  (setvar col (+ col (* (* (* sun-glint Ks) invf) (specular Nw Ir roughness))))
  (setvar col (+ col (* (* Ka (ambient)) base-color)))

  (setvar Oi Os)
  (setvar Ci col))))
(compile-shader seascape-shader)
(append-shader seascape-shader)
