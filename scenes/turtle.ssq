; turtle.ssq - smooth polygon turtle
(scene
  (background 0.42 0.66 0.82)
  (camera (from 3.0 2.55 -6.7) (at 0 0.95 0) (up 0 1 0) (fov 38))
  (light (pos -3.8 5.5 -4.0) (intensity 1.65) (color 1.0 0.95 0.86) (radius 0.75))
