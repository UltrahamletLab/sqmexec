    (mesh (file "$SQM_ROOT/assets/turtle.obj") (smooth 1)
      (group-surface "shell"
        (color 0.20 0.42 0.17) (ka 0.26) (kd 0.76) (ks 0.10) (phong 0) (roi 1)
        (shader hexshell) (param size 0.26) (param seam-width 0.22)
        (param seam-color 0.07 0.13 0.05) (param vary 0.30) (param bump 0.55)
        (param axis 1) (param Ks 0.12) (param roughness 0.35))
      (group-surface "scutes"
        (color 0.20 0.42 0.17) (ka 0.26) (kd 0.76) (ks 0.10) (phong 0) (roi 1)
        (shader hexshell) (param size 0.26) (param seam-width 0.22)
        (param seam-color 0.07 0.13 0.05) (param vary 0.30) (param bump 0.55)
        (param axis 1) (param Ks 0.12) (param roughness 0.35))
      (group-surface "rim"
        (color 0.76 0.59 0.23) (ka 0.24) (kd 0.76) (ks 0.10) (phong 18)
        (shader plastic) (param Ks 0.10) (param roughness 0.4))
      (group-surface "plastron"
        (color 0.82 0.66 0.37) (ka 0.25) (kd 0.75) (ks 0.06) (phong 14)
