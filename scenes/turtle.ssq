      (group-surface "skin"
        (color 0.29 0.67 0.31) (ka 0.28) (kd 0.74) (ks 0.08) (phong 18)
        (shader plastic) (param Ks 0.08) (param roughness 0.4))
      (group-surface "claws"
        (color 0.91 0.81 0.57) (ka 0.25) (kd 0.72) (ks 0.06) (phong 14)
        (shader plastic) (param Ks 0.06) (param roughness 0.46))
      (group-surface "eyes"
        (color 0.98 0.98 0.90) (ka 0.3) (kd 0.70) (ks 0.12) (phong 22)
